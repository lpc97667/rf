+def patch_qwen3_vllm():
+    import os
+    os.environ["VLLM_ATTENTION_BACKEND"] = "XFORMERS"
+    from vllm.model_executor.models.qwen3 import (Qwen3Attention,
+                                                  Qwen3ForCausalLM,
+                                                  Qwen3Model)
+
+    patch_cache_engine()
+
+    def new_qwen3_lm_init(self, *, vllm_config, prefix: str = ""):
+        torch.nn.Module.__init__(self)
+        config = vllm_config.model_config.hf_config
+        quant_config = vllm_config.quant_config
+        lora_config = vllm_config.lora_config
+
+        self.config = config
+        self.lora_config = lora_config
+        self.quant_config = quant_config
+
+        self.model = Qwen3Model(vllm_config=vllm_config,
+                                prefix=maybe_prefix(prefix, "model"))
+
+        if get_pp_group().is_last_rank:
+            if config.tie_word_embeddings:
+                self.lm_head = self.model.embed_tokens
+            else:
+                self.lm_head = ParallelLMHead(config.vocab_size,
+                                              config.hidden_size,
+                                              quant_config=quant_config,
+                                              prefix=maybe_prefix(
+                                                  prefix, "lm_head"))
+        else:
+            self.lm_head = PPMissingLayer()
+
+        convert_linear_weights_to_bfloat16(self.model)
+        if not isinstance(self.lm_head, PPMissingLayer):
+            convert_linear_weights_to_bfloat16(self.lm_head)
+            rf_maybe_downcast_lm_head(self.lm_head, config)
+
+        self.logits_processor = LogitsProcessor(config.vocab_size, scale=1.2)
+        self.sampler = get_sampler()
+        self.make_empty_intermediate_tensors = (
+            self.model.make_empty_intermediate_tensors)
+
+    Qwen3ForCausalLM.__init__ = new_qwen3_lm_init
+
+    original_init = Qwen3Attention.__init__
+    def new_qwen3_init(self, *args, **kwargs):
+        original_init(self, *args, **kwargs)
+        self.rotary_emb = get_rope(
+            self.head_dim,
+            rotary_dim=self.head_dim,
+            max_position=kwargs['max_position'],
+            base=self.rope_theta,
+            rope_scaling=kwargs['rope_scaling'],
+            dtype=torch.float32
+        )
+
+    Qwen3Attention.__init__ = new_qwen3_init
+    UnquantizedLinearMethod.apply = our_linear_apply
+    UnquantizedEmbeddingMethod.apply = our_linear_apply

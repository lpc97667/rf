@@ -7,9 +8,48 @@ from ..base import TaskHandler
 
 class GPQADiamondTaskHandler(TaskHandler):
 
+    def _deterministic_choice_mapping(self, problem):
+        """Return (multiple_choice_string, correct_answer_letter) for `problem`.
+
+        The four options are shuffled with an RNG seeded by a stable hash of
+        the question text. This makes the letter ordering shown to the model
+        identical on every run (reproducibility), and — crucially — lets
+        scoring reconstruct the exact same mapping without depending on any
+        state set during prompt generation. (The eval scripts reload the raw
+        dataset for scoring, which has no "Answer" column, so the previous
+        code raised KeyError: 'Answer'.) A local `random.Random` is used so
+        the global RNG is left untouched. `hashlib` is used rather than the
+        builtin `hash()` because the latter is salted per process
+        (PYTHONHASHSEED) and would not be stable across runs.
+        """
+        answers = [
+            problem["Correct Answer"],
+            problem["Incorrect Answer 1"],
+            problem["Incorrect Answer 2"],
+            problem["Incorrect Answer 3"],
+        ]
+        seed = int(
+            hashlib.md5(str(problem["Question"]).encode("utf-8")).hexdigest(), 16
+        )
+        random.Random(seed).shuffle(answers)
+
+        options = ["A", "B", "C", "D"]
+        options_to_answers = {
+            letter: answer for letter, answer in zip(options, answers)
+        }
+        multiple_choice_string = ", ".join(
+            f"{letter}) {options_to_answers[letter]}" for letter in options
+        )
+        correct_answer_letter = next(
+            letter
+            for letter, answer in options_to_answers.items()
+            if answer == problem["Correct Answer"]
+        )
+        return multiple_choice_string, correct_answer_letter
+
     def generate_prompt(self, problem):
         multiple_choice_string, correct_answer_letter = (
-            self.get_multiple_choice_answers(problem)
+            self._deterministic_choice_mapping(problem)
         )
         problem["Answer"] = correct_answer_letter
         problem["prompt"] = problem["Question"] + "\n" + multiple_choice_string
